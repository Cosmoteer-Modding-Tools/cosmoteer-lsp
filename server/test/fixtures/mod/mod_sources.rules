ID = author.testmod
Name = "Test"
Logo = "logo.png"
Actions
[
	{
		Action = Overrides
		OverrideIn = "<a.rules>"
		Overrides = &<provider.rules>/Provider
	}
	{
		Action = Overrides
		OverrideIn = "<a.rules>"
		Overrides = &<nonexistent.rules>/Provider
	}
	{
		// A `Name` is the key the entry is added under, not a file the game loads.
		Action = Add
		AddTo = "<a.rules>"
		Name = "Small Pirate Lootbox.ship.png"
		ToAdd = 1
	}
]

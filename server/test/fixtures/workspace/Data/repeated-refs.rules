// Guards the find-all-references within-query resolution memo: three identical references to the
// same target under one container. The memo dedups the RESOLUTION work (resolve once), but every
// reference SITE must still be returned, so a query on `V` finds all three.
MemoBase
{
	V = 1
}
Repeated
{
	R1 = &~/MemoBase/V
	R2 = &~/MemoBase/V
	R3 = &~/MemoBase/V
}

// A key whose value is a whole file: the file has no name of its own, so the key is the symbol
// other files write. Guards find-all-references and rename on that shape.
AliasedFile = &<./Data/c.rules>
UsesAlias = &AliasedFile/C/Leaf

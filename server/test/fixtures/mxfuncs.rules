Calc
{
	Sine = sin(0)
	Cosine = cos(0)
	NatLog = ln(1)
	Exp0 = exp(0)
	Sgn = sgn(-5)
	LogBase = "log(2, 8)"
	RoundDec = "round(3.14159, 2)"
	RoundHalf = "round(-2.5, 0)"
	MinOf = "min(3, 1, 2)"
	Circle = pi * 2
	EulerLn = ln(e)
	Unknown = deg(90)
	NotAFunction = pow(2, 10)
	WrongCase = Sqrt(16)
	DecimalDrift = 10 / 3 * 3
	FloorDrift = floor(10 / 3 * 3)
}

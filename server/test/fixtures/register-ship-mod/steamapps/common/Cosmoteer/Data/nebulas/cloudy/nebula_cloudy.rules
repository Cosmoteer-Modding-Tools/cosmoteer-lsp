// A cut-down copy of the game's cloudy nebula: the fields a derived nebula overrides, and the
// materials that carry the three colours, one of them derived from another the way the game's is.
ID = cloudy
ToolTipKey = "Nebulas/Cloudy"
SightRangeFactor = 30%
RadarRangeFactor = 75%
HudTextKey = "Nebulas/CloudyHudFmt"
HudIcon
{
	Texture
	{
		File = "icon.png"
		MipLevels = 2
		SampleMode = Linear
	}
}
MaterialLow
{
	Color = [255, 255, 255, 255]
	Shader = "../nebula.shader"
	_color1 = [98, 150, 214, 255]
	_color2 = [160, 233, 209, 255]
	_color3 = [216, 140, 155, 255]
	_midTexScale = 0.0005
}
SimpleMaterialLow : MaterialLow
{
	Shader = "../nebula_simple.shader"
}
MaterialHigh
{
	Color = [255, 255, 255, 255]
	Shader = "../nebula.shader"
	_color1 = [172, 199, 200, 255]
	_color2 = [160, 233, 209, 255]
	_color3 = [216, 140, 155, 255]
}
MaterialMinimap = &MaterialLow

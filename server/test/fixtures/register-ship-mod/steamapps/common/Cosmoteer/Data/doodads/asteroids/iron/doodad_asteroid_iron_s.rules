// A cut-down copy of the game's small iron asteroid: the id and the recipe stages a mod's own copy.
ID = cosmoteer.asteroid_iron_s
Type = GeneratedShip
DescriptionKey = "Doodads/AsteroidIron_S"
CategoryKey = "Doodads/Asteroids"
Tags = [asteroid]
Icon
{
	Texture
	{
		File = "asteroid_iron_s.png"
		MipLevels = 2
		SampleMode = Linear
	}
}
Allegiance = -3
SpawnRadius = sqrt(&Generator/Stages/0/MaxParts)
Generator
{
	ShipRulesID = "cosmoteer.asteroid"
	Stages
	[
		{
			Type = AsteroidStage
			Name = AsteroidStage
			IsEnabled = true
			Parts
			[
				cosmoteer.rock_1x1
			]
			MinParts = 100
			MaxParts = 200
		}
		{
			Type = AsteroidDepositsStage
			ReplaceableParts
			[
				cosmoteer.rock_1x1
			]
			Name = AsteroidDepositsStage
			IsEnabled = true
			Parts
			[
				cosmoteer.deposit_iron_1x
				cosmoteer.deposit_iron_2x
				cosmoteer.deposit_iron_3x
			]
			MinPartsFraction = 0.125 * (&<./Data/resources/iron/iron.rules>/AsteroidDensity)
			MaxPartsFraction = 0.25 * (&<./Data/resources/iron/iron.rules>/AsteroidDensity)
			MinPartsPerDeposit = 3
			MaxPartsPerDeposit = 10
		}
		{
			Type = ConvertTypeStage
			Conversions = &<../hard_conversions.rules>/Conversions
			ChanceAtCenter = 1.2
			ChanceAtEdge = 0
			Name = ConvertTypeStage
			IsEnabled = true
			ChanceExponent = 1
		}
	]
}

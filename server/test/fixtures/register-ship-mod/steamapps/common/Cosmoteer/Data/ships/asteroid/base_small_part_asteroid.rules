{
	Size = [1, 1]
	Density = 10
	MaxHealth = 10000
	Flammable = false
	IsRotateable = true
	CrewSpeedFactor = 0
	TypeCategories = [asteroid]

	Components : ^/0/Components
	{
	}
}

# What ships in the VSIX is the esbuild bundle in out/ plus the static contribution assets
# (images, syntaxes, l10n, media, language configuration) and package.json/README/LICENSE/CHANGELOG.
# Everything below is excluded because it is dev-only or already bundled.

# --- Editor / tooling / CI config ---
.vscode/**
.vscode-test/**
.idea/**
.claude/**
.github/**
.gitignore
.prettierignore
.prettierrc.json5
.git-blame-ignore-revs
.githooks/**
eslint.config.mjs
# Matched by extension rather than by name: the config is `.mts`, and a `vitest.config.ts` entry
# stopped matching it without anything saying so.
vitest.config.*
esbuild.mjs
esbuild.cache-id.mjs
package-lock.json
CONTRIBUTING
SUPPORT.md
.travis.yml
**/tsconfig.json
**/tsconfig.base.json

# --- Sources and build metadata (the runtime is the esbuild bundle in out/) ---
**/*.ts
**/*.map
out/**/*.tsbuildinfo
# `tsc -b` (compile:tsc, and scripts/e2e.sh building the test runner) emits a `.js` beside every
# source file under out/. Nothing loads them: the extension entry, the server the client spawns and
# the lint command are all `.mjs` bundles, and esbuild writes only those three. A dev who has run
# either command otherwise ships 8 MB of dead files.
out/**/*.js

# --- Tests, fixtures, snapshots ---
**/test/**
**/testFixture/**
**/__snapshots__/**
**/*.snap

# --- Repo tooling, docs, media and the JetBrains plugin (not part of the extension) ---
jetbrains/**
# The assembled npm package for the lint command, which `package:cli` writes and the npm release
# publishes. It carries its own copy of the server bundle, so leaving it in doubled the VSIX.
cli-package/**
tools/**
docs/**
showcase/**
scripts/**
# The plist grammar is staged into the JetBrains TextMate bundle; VS Code loads the .json grammars.
syntaxes/rules.tmLanguage
images/README.md
images/CLS_Transparent_full_iconx128.png

# --- Subpackage build outputs and manifests: bundled into out/, not loaded at runtime ---
client/out/**
client/package.json
client/package-lock.json
server/**

# --- node_modules: esbuild bundles every dependency (only 'vscode' is external), so the
#     packaged bundle requires nothing from node_modules at runtime. ---
node_modules/**
**/node_modules/**

{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": false,
        "types": []
    },
    "include": ["src/**/*.js", "*.d.ts"]
}
